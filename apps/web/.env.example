# Browser-visible. Used only for unauthenticated multipart lead submission.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Browser-visible Supabase project identifiers. Supabase access tokens are not
# copied into application state and protected API calls stay server-side.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>

# Server-only protected API origin and canonical web origin.
API_URL=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:3000

# At least 32 random bytes. Used to bind CSRF tokens to an authenticated user.
CSRF_SECRET=<at-least-32-random-characters>
