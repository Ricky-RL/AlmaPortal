# Services. Start the web and API processes separately.
E2E_WEB_BASE_URL=http://127.0.0.1:3000
E2E_API_BASE_URL=http://127.0.0.1:8000
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Synthetic local dashboard user. Never use production credentials.
E2E_AUTH_EMAIL=dashboard@alma-e2e.invalid
E2E_AUTH_PASSWORD=Alma-e2e-local-only-2026!

# Browser routes and API paths.
E2E_PUBLIC_FORM_PATH=/
# Leave unset for the current inline success state. Set only for a routed UI.
# E2E_SUCCESS_PATH=/success
E2E_LOGIN_PATH=/login
E2E_DASHBOARD_PATH=/leads
E2E_SUBMISSION_API_PATH=/api/v1/leads
E2E_FIELD_FIRST_NAME=first_name
E2E_FIELD_LAST_NAME=last_name
E2E_FIELD_EMAIL=email
E2E_FIELD_ACKNOWLEDGED=synthetic_data_acknowledged
E2E_FIELD_CV=resume
E2E_FIELD_COMMENTS=comments

# Local data contract and cleanup.
E2E_LEADS_TABLE=leads
E2E_NOTIFICATIONS_TABLE=email_deliveries
E2E_LEAD_ID_COLUMN=id
E2E_LEAD_EMAIL_COLUMN=normalized_email
E2E_LEAD_STATUS_COLUMN=status
E2E_NOTIFICATION_LEAD_ID_COLUMN=lead_id
E2E_NOTIFICATION_STATUS_COLUMN=state
E2E_STORAGE_BUCKET=resumes
E2E_STORAGE_PATH_COLUMN=resume_object_path
E2E_TEST_EMAIL_DOMAIN=alma-e2e.invalid
E2E_CURSOR_FIXTURE_COUNT=26
E2E_MAX_UPLOAD_BYTES=10485760

# Configure the API's Resend base URL to this origin before starting it.
E2E_RESEND_STUB_ORIGIN=http://127.0.0.1:4319
RESEND_BASE_URL=http://127.0.0.1:4319
E2E_START_RESEND_STUB=true
