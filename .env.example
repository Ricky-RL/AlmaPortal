# Supabase and PostgreSQL
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=replace-with-local-supabase-jwt-secret
DATABASE_URL=postgresql://alma_api:replace-with-local-runtime-password@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Google OAuth for local Supabase Auth. Create a Web application client in
# Google Cloud Console. Authorized JavaScript origins are
# http://127.0.0.1:3000 and http://localhost:3000. The authorized redirect URI
# is this GoTrue callback, not the Next.js /auth/callback route.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/auth/v1/callback

# Email. Local tests and Playwright use the loopback capture stub.
# Point RESEND_BASE_URL at https://api.resend.com to send real mail.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_BASE_URL=http://127.0.0.1:4319
RESEND_FROM_EMAIL=onboarding@resend.dev
ATTORNEY_NOTIFICATION_EMAIL=attorney@example.invalid

# Application origins
PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_SECRET=replace-with-at-least-32-random-bytes

# Protected downloads
TICKET_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Deployment
SUPABASE_ACCESS_TOKEN=replace-with-supabase-access-token
SUPABASE_PROJECT_REF=replace-with-supabase-project-ref
SUPABASE_DB_PASSWORD=replace-with-supabase-database-password
RENDER_SERVICE_ID=replace-with-render-service-id
RENDER_API_KEY=replace-with-render-api-key
VERCEL_ORG_ID=replace-with-vercel-organization-id
VERCEL_PROJECT_ID=replace-with-vercel-project-id
VERCEL_TOKEN=replace-with-vercel-token
API_BASE_URL=replace-with-deployed-api-origin

# Local Supabase signs sessions with HS256. Hosted production uses RS256/ES256
# and must not set SUPABASE_JWT_SECRET.
ENVIRONMENT=development
WEB_CONCURRENCY=1
JWT_ALGORITHMS=HS256
TRUSTED_PROXY_CIDRS=
OVERALL_BODY_CAP_BYTES=12582912
PUBLIC_RATE_LIMIT=60
PUBLIC_RATE_WINDOW_SECONDS=900
PROVIDER_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO

# Build metadata
COMMIT_SHA=local-development
RENDER_GIT_COMMIT=replace-with-deployed-commit-sha
